      ],
      "historic_milestone": "First team from Kerala to win Formula Bharat championship (combustion category) — Formula Bharat 2025 at Kari Motor Speedway, Coimbatore.",
      "future_competitions": ["Formula Imperial 2025", "Formula Bharat 2026"],
